<Project>
  <PropertyGroup>
    <NovrRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</NovrRepoRoot>
    <NovrRepoRoot Condition="!HasTrailingSlash('$(NovrRepoRoot)')">$(NovrRepoRoot)/</NovrRepoRoot>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SkipNuclearOptionReferences>true</SkipNuclearOptionReferences>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS0626;CS0809;CS0108;CS0114;CS0169;CS0649;CS0067;CS8612</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net48</TargetFramework>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
